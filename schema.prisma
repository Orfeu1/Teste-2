generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String
  role String @default("user")
  blocked Boolean @default(false)
  createdAt DateTime @default(now())
  wallet Wallet?
  transactions Transaction[]
  claims RewardClaim[]
}
model Wallet {
  id String @id @default(uuid())
  userId String @unique
  balance BigInt @default(0)
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
}
model Transaction {
  id String @id @default(uuid())
  userId String
  type String
  amount BigInt
  description String
  status String @default("completed")
  reference String? @unique
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@index([userId, createdAt])
}
model RewardCampaign {
  id String @id
  name String
  rewardCents BigInt
  budgetCents BigInt
  active Boolean @default(true)
  claims RewardClaim[]
}
model RewardClaim {
  id String @id @default(uuid())
  userId String
  campaignId String
  amount BigInt
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  campaign RewardCampaign @relation(fields: [campaignId], references: [id])
  @@unique([userId, campaignId])
}

model AppSetting {
  key String @id
  value Json
  updatedAt DateTime @updatedAt
}
